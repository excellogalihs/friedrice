{
  "layer": "top",
  "modules-left": ["custom/arch", "clock"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["pulseaudio", "network", "battery"],
  "custom/arch": {
    "format": " 󰣇 ",
    "tooltip": false,
    "on-click": "hyprmod"
  },
  "clock": {
    "format": "󰥔 {:%a, %d. %b  %H:%M}",
    "tooltip": false
  },
  "hyprland/workspaces": {
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-icons": {
      "default": ["", " ", " "]
    },
    "scroll-step": 5,
    "tooltip": false
  },
  "network": {
    "format": "  {essid}",
    "tooltip": false,
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""],
    "tooltip": false
  },
}
