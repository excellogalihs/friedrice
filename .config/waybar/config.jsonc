{
  "position": "top",
  "margin-top": 10,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": ["custom/arch", "power-profiles-daemon", "custom/power"],
  "modules-center": ["clock", "hyprland/workspaces"],
  "modules-right": ["pulseaudio", "network", "battery"],
  "custom/arch": {
    "format": " 󰣇 ",
    "tooltip-format": " Settings ",
    "on-click": "hyprmod"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "default": "  ",
      "performance": "  ",
      "balanced": "  ",
      "power-saver": "  "
    },
    "tooltip": false
  },
  "custom/power": {
    "format": "  ",
    "tooltip": false,
    "on-click": "wlogout"
  },
  "clock": {
    "format": " {:%I:%M %p} ",
    "tooltip-format": " {:%A, %B %d, %Y} "
  },
  "hyprland/workspaces": {
    "format": " {icon} ",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": ""
    },
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },
  "pulseaudio": {
    "format": " {icon}{volume}% ",
    "format-icons": {
      "default": [" ", " ", " "]
    },
    "scroll-step": 5,
    "tooltip": false,
    "on-click": "kitty zsh -ic 'wiremix'"
  },
  "network": {
    "format": " 󰤥 {essid} ",
    "tooltip": false,
    "on-click": "kitty zsh -ic 'nmtui'"
  },
  "battery": {
    "format": " {icon}{capacity}% ",
    "format-icons": [" ", " ", " ", " ", " "],
    "tooltip": false
  },
}
