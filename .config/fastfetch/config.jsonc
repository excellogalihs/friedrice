{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small"
    },
    "display": {
        "separator": "",
        "key": {
            "width": 3
        }
    },
    "modules": [
        {
            "key": " ",
            "keyColor": "31",
            "type": "title",
            "format": "{user-name}",
        },
        {
            "key": "󰅐 ",
            "keyColor": "32",
            "type": "uptime",
        },
        {
            "key": " ",
            "keyColor": "33",
            "type": "shell",
            "format": "zsh",
        },
        {
            "key": "󰣇 ",
            "keyColor": "34",
            "type": "os",
            "format": "arch btw",
        },
        {
            "key": " ",
            "keyColor": "35",
            "type": "kernel",
            "format": "linux",
        },
        {
            "key": " ",
            "keyColor": "36",
            "type": "terminal",
            "format": "kitty",
        },
        {
            "key": " ",
            "keyColor": "37",
            "type": "colors",
            "symbol": "circle",
        }
    ]
}
