{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small"
    },
    "display": {
        "separator": "",
        "key": {
            "width": 15
        }
    },
    "modules": [
        {
            "key": " user",
            "keyColor": "31",
            "type": "title",
            "format": "{user-name}",
        },
        {
            "key": "󰅐 uptime",
            "keyColor": "32",
            "type": "uptime",
        },
        {
            "key": " shell",
            "keyColor": "33",
            "type": "shell",
            "format": "zsh",
        },
        {
            "key": " distro",
            "keyColor": "34",
            "type": "os",
            "format": "arch btw",
        },
        {
            "key": " kernel",
            "keyColor": "35",
            "type": "kernel",
            "format": "linux",
        },
        {
            "key": " terminal",
            "keyColor": "36",
            "type": "terminal",
            "format": "kitty",
        },
        {
            "key": " colors",
            "keyColor": "37",
            "type": "colors",
            "symbol": "circle",
        }
    ]
}
